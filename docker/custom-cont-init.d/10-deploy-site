#!/usr/bin/with-contenv bash
# Replace the served site in /config/www with the one baked into this image,
# so a new image always serves its own build even though /config persists.

set -e

rm -rf /config/www
mkdir -p /config/www
cp -a /app/site/. /config/www/
lsiown -R abc:abc /config/www

echo "[deploy-site] Copied site build into /config/www"
